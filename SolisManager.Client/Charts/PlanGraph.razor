@using ApexCharts

@inherits ChartBase<PricePlanSlot>

<ErrorBoundary>
    @if (Options != null && ChartData != null && ChartData.Any())
    {
        <div class="chart-area">
            <GraphActionLegend ChartTitle="Charging Strategy Graph"/>
            <ApexChart @ref="chart" TItem="PricePlanSlot" 
                       XAxisType="XAxisType.Datetime"
                       Options="@Options"
                       Height="@("100%")">

                <ApexPointTooltip>
                    @{
                        var slot = context.DataPoint.Items.FirstOrDefault();
                    }
                    @if (slot != null)
                    {
                        <div class="chart-tooltip">
                            <div class="chart-tooltip-title">@slot.valid_from.ToString("dd-MMM HH:mm")</div>
                            <div class="price-row">
                                <span><span class="tooltip-marker import-marker"></span>Import</span>
                                <span>@slot.value_inc_vat.ToString("F2")p/kWh</span>
                            </div>
                            @if (slot.export_value_inc_vat is decimal exportPrice)
                            {
                                <div class="price-row">
                                    <span><span class="tooltip-marker export-marker"></span>Export</span>
                                    <span>@exportPrice.ToString("F2")p/kWh</span>
                                </div>
                            }
                            @if (slot.pv_est_kwh is decimal forecast)
                            {
                                <div class="price-row">
                                    <span><span class="tooltip-marker forecast-marker"></span>PV Forecast</span>
                                    <span>@forecast.ToString("F1")kWh</span>
                                </div>
                            }
                        </div>
                    }
                </ApexPointTooltip>

                <ChildContent>
                <ApexPointSeries TItem="PricePlanSlot"
                                 Items="ChartData"
                                 Name="Price (p/kWh)"
                                 XValue="@(e => e.valid_from)"
                                 YAggregate="@(e => e.Average(e => e.value_inc_vat))"
                                 SeriesType="SeriesType.Bar"
                                 Color="#005ba3"
                                 PointColor="e => GetColor(e)"
                                 Stroke="@(new SeriesStroke { Width = 0 })"/>

                <ApexPointSeries TItem="PricePlanSlot"
                                 Items="ChartData"
                                 Name="Export Price (p/kWh)"
                                 XValue="@(e => e.valid_from)"
                                 YValue="@(e => e.export_value_inc_vat)"
                                 SeriesType="SeriesType.Line"
                                 Color="#8e44ad"
                                 Hidden="@(!ChartData.Any(x => x.export_value_inc_vat != null))"
                                 Stroke="@(new SeriesStroke { Color = "#8e44ad", Width = 3 })"/>

                <ApexPointSeries TItem="PricePlanSlot"
                                 Items="ChartData"
                                 Name="PV Forecast (kWh)"
                                 XValue="@(e => e.valid_from)"
                                 YValue="@(e => e.pv_est_kwh)"
                                 SeriesType="SeriesType.Line"
                                 Color="darkorange"
                                 Hidden="@(!ChartData.Any(x => x.pv_est_kwh > 0))"
                                 Stroke="@(new SeriesStroke { Color = "darkorange", Width = 3 })"/>
                    </ChildContent>
                </ApexChart >
        </div>
    }
</ErrorBoundary>

@code {
    [Parameter] public IEnumerable<PricePlanSlot> ChartData { get; set; } = [];
    
    private string FormatYAxisLabel(decimal val) => val == (int)val ? $"{val:F0}" : $"{val:F2}";

    private string GetColor(PricePlanSlot planSlot) => GetActionColour(planSlot.ActionToExecute.action);

    private string GetActionColour(SlotAction action) =>
            action switch
        {
            SlotAction.Charge => "royalblue",
            SlotAction.Discharge => "forestgreen",
            SlotAction.ChargeIfLowBattery => "darkorange",
            SlotAction.Hold => "orangered",
            _ => "rgba(200,200,200, 0.8)"
        };
    
    private RenderFragment ActionLegend( SlotAction a )
    {
        var style = $"color:{GetActionColour(a)}";
        return @<div>
                   <MudIcon style="@style" Icon="@Icons.Material.Filled.Circle" Size="@MudBlazor.Size.Small"/>
                   @a.Description()
               </div>;
    }

    protected override void SetOptions(ApexChartOptions<PricePlanSlot> options)
    {
        var yAxis = new List<YAxis>
        {
            new()
            {
                Title = new AxisTitle { Text = "Price (p/kWh)" },
                SeriesName = new SeriesName(["Price (p/kWh)", "Export Price (p/kWh)"]),
                Min = 0,
                DecimalsInFloat = 2
            },
            new()
            {
                Title = new AxisTitle { Text = "PV Forecast (kWh)" },
                SeriesName = "PV Forecast (kWh)",
                DecimalsInFloat = 1,
                Opposite = true,
            },
        };

        options.Yaxis = yAxis;
        options.Xaxis = new XAxis { Labels = new XAxisLabels { DatetimeUTC = false } };
        options.Legend = new Legend
        {
            Position = LegendPosition.Bottom,
            HorizontalAlign = ApexCharts.Align.Center,
            ClusterGroupedSeries = false,
            ItemMargin = new LegendItemMargin { Horizontal = 8, Vertical = 0 }
        };
    }
}
